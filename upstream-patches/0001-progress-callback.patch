diff --git a/tests/test_progress_callback.py b/tests/test_progress_callback.py
new file mode 100644
index 0000000..6db1448
--- /dev/null
+++ b/tests/test_progress_callback.py
@@ -0,0 +1,48 @@
+"""apply_model reports segment progress through ``progress_callback``."""
+from __future__ import annotations
+
+import mlx.core as mx
+import numpy as np
+
+from demucs_mlx.apply_mlx import apply_model
+
+
+class _IdentityModel:
+    samplerate = 44_100
+    segment = 1.0
+    sources = ["mix"]
+
+    def valid_length(self, length: int) -> int:
+        return int(length)
+
+    def __call__(self, x: mx.array) -> mx.array:
+        return x[:, None, :, :]
+
+
+def _mix(seconds: float):
+    n = int(seconds * _IdentityModel.samplerate)
+    return mx.array(np.zeros((1, 2, n), dtype=np.float32))
+
+
+def test_callback_counts_segments_for_one_pass():
+    calls = []
+    apply_model(
+        _IdentityModel(), _mix(3.0), shifts=0, split=True, overlap=0.0, batch_size=1,
+        progress_callback=lambda done, total: calls.append((done, total)),
+    )
+    assert calls[0] == (0, 3)
+    assert calls[-1] == (3, 3)
+    assert [c[0] for c in calls] == sorted(c[0] for c in calls)
+
+
+def test_callback_runs_once_per_shift_pass():
+    calls = []
+    apply_model(
+        _IdentityModel(), _mix(2.0), shifts=2, seed=0, split=True, overlap=0.0, batch_size=1,
+        progress_callback=lambda done, total: calls.append((done, total)),
+    )
+    assert sum(1 for done, _ in calls if done == 0) == 2
+
+
+def test_no_callback_is_default():
+    apply_model(_IdentityModel(), _mix(2.0), shifts=0, split=True, overlap=0.0, batch_size=1)
